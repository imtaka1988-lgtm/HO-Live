# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=loopback
JSON_BODY_LIMIT=6mb

# Generate a random value of at least 32 characters before deployment.
JWT_SECRET=replace-with-a-long-random-secret
BCRYPT_ROUNDS=10

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=haiou_live
DB_USER=haiou_app
DB_PASS=replace-with-database-password
DB_POOL_SIZE=10
DB_POOL_MAX_IDLE=10
DB_POOL_IDLE_TIMEOUT=60000
DB_QUEUE_LIMIT=100

# Browser/API origins. Leave empty for same-origin deployment.
CORS_ORIGIN=https://s6.lol,https://www.s6.lol

# WebSocket
CHAT_ALLOWED_ORIGINS=https://s6.lol,https://www.s6.lol
CHAT_WS_MAX_CONNECTIONS_PER_IP=20
CHAT_WS_MAX_CONNECTIONS_TOTAL=1000
CHAT_WS_MAX_PAYLOAD_BYTES=16384
CHAT_WS_MAX_BUFFERED_BYTES=1048576
CHAT_WS_AUTH_TIMEOUT_MS=5000
CHAT_WS_HEARTBEAT_MS=30000
CHAT_HISTORY_LIMIT=50

# Live stream provisioning and provider callback
LIVE_PROVIDER=manual
LIVE_APP_NAME=live
LIVE_PUSH_DOMAIN=
LIVE_PULL_DOMAIN=
LIVE_PUSH_PROTOCOL=rtmp
LIVE_CALLBACK_KEY=replace-with-a-long-random-callback-key
LIVE_CALLBACK_ALLOW_UNSIGNED=0
LIVE_CALLBACK_ALLOW_QUERY_KEY=0

# Article, schedule and odds upstream caches
ARTICLE_LIST_CACHE_TTL_MS=300000
ARTICLE_DETAIL_CACHE_TTL_MS=1800000
ARTICLE_LIST_CACHE_MAX_ENTRIES=64
ARTICLE_DETAIL_CACHE_MAX_ENTRIES=300
ARTICLE_FETCH_TIMEOUT_MS=8000
ARTICLE_MAX_RESPONSE_BYTES=3145728
SCHEDULE_CACHE_TTL_MS=300000
ESPN_TIMEOUT_MS=8000
ESPN_MAX_RESPONSE_BYTES=2097152
ODDS_API_TIMEOUT_MS=5000
ODDS_CACHE_TTL_MS=300000
ODDS_MAX_RESPONSE_BYTES=4194304

# Replay metadata and cover proxy
REPLAY_META_TIMEOUT_MS=9000
REPLAY_META_MAX_BYTES=2097152
REPLAY_META_CACHE_TTL_MS=3600000
REPLAY_META_CACHE_MAX_ENTRIES=200
REPLAY_COVER_TIMEOUT_MS=9000
REPLAY_COVER_MAX_BYTES=10485760

# Optional external odds service
ODDS_API_KEY=

# HTTP server
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEPALIVE_TIMEOUT_MS=5000

# One-time administrator bootstrap. Prefer passing these inline to
# `npm run create-admin` instead of storing them permanently in .env.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password
